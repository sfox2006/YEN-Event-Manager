{
  "id": "./",
  "name": "YEN Event Manager",
  "short_name": "YEN Events",
  "description": "Shared event planning for the Young Economists Network Organising Committee.",
  "start_url": "./#/dashboard",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f4f6f8",
